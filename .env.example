# API (services/api)
FLOW_DATABASE_URL=postgresql://flow:flow@localhost:55432/flow
# Local API talking to Redis from Docker Compose (host port 16379 → container 6379). Omit if using Redis on :6379 locally.
# FLOW_REDIS_URL=redis://localhost:16379/0
FLOW_JWT_SECRET=change-me-use-openssl-rand-hex-32
FLOW_OPENAI_API_KEY=
# Optional. CV import + preference extraction prefer Anthropic Haiku; falls back to OpenAI if unset.
FLOW_ANTHROPIC_API_KEY=
# Comma-separated. For local Next on :3000 use http://localhost:3000.
# If the UI is Docker Compose on host :13000, add http://localhost:13000 (see docker-compose.yml).
FLOW_CORS_ORIGINS=http://localhost:3000
FLOW_LOG_LEVEL=INFO
FLOW_LOG_JSON=false
# ANSI colors in docker logs (structlog). Or set FORCE_COLOR=1 in shell.
FLOW_LOG_FORCE_COLORS=false

# LangSmith (LangChain/LangGraph traces) — https://smith.langchain.com
# Tracing defaults ON when this key is set (FLOW_LANGSMITH_TRACING=false to disable).
# Worker sets LANGCHAIN_* before importing LangGraph — use the same key in API + worker env.
# Docker Compose `api`/`worker` load repo-root `.env` via env_file; overrides in compose still win.
# FLOW_LANGSMITH_API_KEY=lsv2_pt_...
# FLOW_LANGSMITH_PROJECT=flow-local
# FLOW_LANGSMITH_TRACING=true
# EU region: FLOW_LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# Optional: LANGSMITH_* / LANGCHAIN_* names are also read when FLOW_* is unset.

# Agentic RAG — Qdrant hybrid (host port 16333 when using docker-compose qdrant service)
# FLOW_QDRANT_URL=http://localhost:16333
# FLOW_QDRANT_COLLECTION=flow_knowledge
# FLOW_AGENTIC_RAG_ENABLED=true
# FLOW_TAVILY_API_KEY=

# Web (apps/web) — put in apps/web/.env.local for Next dev; Compose uses :18000 on the host.
# Code default when unset is http://localhost:18000 (matches docker-compose).
# Local uvicorn only: use http://localhost:8000
NEXT_PUBLIC_FLOW_API_URL=http://localhost:18000
